# /etc/mallway/mallway.env  — UMA cópia só, permissão 640 (root:mallway). Nunca commitar o arquivo real.
#   install -d -m 750 -o root -g mallway /etc/mallway
#   install -m 640 -o root -g mallway mallway.env.example /etc/mallway/mallway.env   # e então edite os valores
MALLWAY_ENV=prod
# Gere com: python3 -c "import secrets; print(secrets.token_urlsafe(48))"  (em prod o app recusa subir com chave curta)
MALLWAY_SECRET_KEY=TROQUE-POR-UMA-CHAVE-ALEATORIA-DE-48-CARACTERES-OU-MAIS
MALLWAY_DATABASE_URL=postgresql+psycopg://mallway:SENHA_DO_BANCO@127.0.0.1:5432/mallway
MALLWAY_PUBLIC_DIR=/var/lib/mallway/public
# Em produção o Nginx serve /p/ direto do disco
MALLWAY_SERVE_STATIC=0
